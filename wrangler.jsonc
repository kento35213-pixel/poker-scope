// Cloudflare Workers: dist/ の静的ファイルを配信します。
// 管理画面で作る Worker 名は name と一致させてください。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker-scope",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
